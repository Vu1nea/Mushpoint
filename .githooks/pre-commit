#!/bin/sh
# Blocks a commit whose staged changes contain a secret. Enable once per clone:
#   git config core.hooksPath .githooks
# Uses a local gitleaks if installed, else the same image CI runs. Skip only
# for a known false positive: add its fingerprint to .gitleaksignore instead.
set -e
root=$(git rev-parse --show-toplevel)

if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks git --staged --redact --no-banner "$root"
fi
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  # Git Bash on Windows would rewrite /repo into a Windows path.
  MSYS_NO_PATHCONV=1 exec docker run --rm -v "$root:/repo" -w /repo zricethezav/gitleaks:v8.21.2 \
    git --staged --redact --no-banner /repo
fi
echo "pre-commit: gitleaks not found and Docker is not running; secret scan skipped." >&2
echo "pre-commit: install gitleaks (https://github.com/gitleaks/gitleaks) or start Docker." >&2
