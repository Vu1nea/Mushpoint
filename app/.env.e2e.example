# Copy to .env.e2e (gitignored) and fill in. Must name the same Supabase project
# as static/config.json and ../server/.env, and the server needs its database up.
E2E_SUPABASE_URL=https://your-project.supabase.co
# Secret key (sb_secret_...) or legacy service_role JWT: creates and deletes the throwaway test users. Never commit it.
E2E_SUPABASE_SERVICE_KEY=
# Password given to both throwaway users (8+ characters).
E2E_PASSWORD=
